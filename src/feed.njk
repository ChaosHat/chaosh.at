---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{%- set entries = collections.feed -%}
{#- The epoch fallback only fires on a site with zero entries; anything
    date-shaped keeps the build alive there (site.built never existed). -#}
{%- set newest = entries[0].shipped if entries | length -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/</id>
  <author><name>{{ site.author }}</name></author>
  {#- Feed-level updated is the newest ENTRY date, never the build time: a
      build-time value would churn the file on every deploy for no reason. -#}
  <updated>{{ newest | atomDate if newest else "1970-01-01T00:00:00.000Z" }}</updated>
  {%- for entry in entries %}
  <entry>
    <title>{{ entry.title }}</title>
    <link href="{{ site.url }}{{ entry.url }}" rel="alternate" type="text/html"/>
    {#- A permanent, opaque identifier. Readers dedupe on this, so it must never
        change once published — not if the title changes, not if the post is
        edited. Built from the date and path, both of which are fixed. -#}
    <id>tag:chaosh.at,{{ entry.date | dateSlug }}:{{ entry.url }}</id>
    {#- Both pinned to when the post first shipped (its date, for posts older
        than shipped.json). NEVER the edit or build time — advancing these is
        exactly what re-surfaces a post in every reader. -#}
    <published>{{ entry.shipped | atomDate }}</published>
    <updated>{{ entry.shipped | atomDate }}</updated>
    {#- Per entry as well as on the feed: an aggregator that re-serves the
        entry drops the feed-level author. -#}
    <author><name>{{ site.author }}</name></author>
    <summary type="html">{{ entry.html | feedSummary | absoluteUrls(site.url) | escape }}</summary>
    <content type="html">{{ entry.html | absoluteUrls(site.url) | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
