---
layout: base.njk
title: Essays
permalink: /essays/
---
{#- "Essays" everywhere the site points here (the nav word, the panel's
    "latest essays") since 2026-11-02; the name Hat calls them lives on the
    page itself. -#}
<h1>Essays</h1>
<p class="essays-aka">aka my deep thoughts</p>

<ul class="essay-list">
  {% for e in collections.essayPages | sort(true, false, "date") %}
  <li>
    {% if e.chipUrl %}<span class="sky" style="background-image:url({{ e.chipUrl }})" aria-hidden="true"></span>{% endif %}
    <a href="{{ e.url }}">{{ e.title }}</a>
    <span class="archive-note">{{ e.date | readableDate }}</span>
  </li>
  {% else %}
  <li class="empty">Nothing here yet.</li>
  {% endfor %}
</ul>
