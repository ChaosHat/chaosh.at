layout: base.njk
pagination:
  data: collections.groupLogPages
  size: 1
  alias: group
  addAllPagesToCollections: false
navView: log
permalink: "{{ group.urls.log }}"
eleventyComputed:
  title: "Log: {{ group.label }}"
---
{#- A medium's log (2026-10-25): the dailies filtered down to one group.
    Hat: "if someone wants to filter the dailies down to that media". A day
    can be about several media, so this is every ## section about the
    medium's subjects, newest first, not whole posts. The way back to the
    whole stream is the wordmark, or "every post →" here (the archive). -#}
{%- set view = {
  title: "Log · " + group.label,
  description: null,
  members: [],
  entries: group.log,
  backUrl: "/archive/",
  backLabel: "every post →"
} %}
{%- set emptyLabel = "Nothing written yet." %}
{% include "view.njk" %}
