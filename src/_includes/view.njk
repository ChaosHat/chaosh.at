{#- A VIEW page: a heading, a definition, the games it gathers, and one mixed
    timeline of everything written about them. Two things take this shape —
    /t/ (a curated tagview, membership authored in tagviews.yaml) and /f/ (a
    feel view, membership DERIVED by grouping subjects on their `feel:`) — and
    they differ only in where the member list comes from, which is settled by
    the time this renders. Sharing the body is the reason /f/ cost a template
    and not a page type.

    Callers set `view` (slug, title, glyph, description, members, entries) and
    `emptyLabel`. The `.tag-*` classes are structural and read as "view page"
    here, tagview or feel alike — see the tag-page block in style.css. -#}
<article class="tag">
  <header class="tag-head">
    <h1>{% if view.glyph %}<span class="view-glyph" aria-hidden="true">{{ view.glyph }}</span> {% endif %}{{ view.title }}</h1>
    {% if view.description %}<p class="tag-desc">{{ view.description }}</p>{% endif %}
    {#- Membership IS the definition of the view, so it goes at the top rather
        than being inferred from the timeline below. -#}
    {% if view.members | length %}
    <p class="tag-members">
      {% for member in view.members %}<a href="/s/{{ member.slug }}/">{{ member.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </p>
    {% endif %}
  </header>

  {#- Members' standing blurbs, above the timeline: undated, so they can't
      slot into the stream — they sit where the view's definition does. Each
      row carries the member's chip and links home, same grammar as a
      fragment's meta line. Blurbs are written to fit, so full text here. -#}
  {% set blurbed = view.members | selectattr("blurbHtml") | list %}
  {% if blurbed | length %}
  <section class="blurbs">
    {% for member in blurbed %}
    <div class="fragment">
      <p class="fragment-meta">
        <span class="sky" style="background-image:url({{ member.chipUrl }})" aria-hidden="true"></span>
        <a class="fragment-subject" href="/s/{{ member.slug }}/">{{ member.title }}</a>
      </p>
      {{ member.blurbHtml | safe }}
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if view.entries | length %}
  <section class="timeline">
    {% for entry in view.entries %}
    <div class="fragment">
      {#- The sky repeats here because this is the one timeline that MIXES
          subjects: the hue says which game before the label has been read.
          An essay is its own thing, not a subject — its row carries its
          title instead of a chip, and its lede links to its /e/ page, the
          full text's one home. Feel views carry no essays at all (an essay is
          about a game, not a reaction to one), so this branch simply never
          fires there — no conditional needed. -#}
      {% if entry.kind == "essay" %}
      <a class="essay-title" href="{{ entry.url }}">{{ entry.title }}</a>
      <a class="fragment-date" href="{{ entry.url }}">{{ entry.date | readableDate }}</a>
      <p class="tag-essay">{{ entry.blurb }}</p>
      <a class="more" href="{{ entry.url }}">read →</a>
      {% else %}
      <p class="fragment-meta">
        <span class="sky" style="background-image:url({{ entry.subject.chipUrl }})" aria-hidden="true"></span>
        <a class="fragment-date" href="{{ entry.url }}">{{ entry.date | readableDate }}</a>
        <a class="fragment-subject" href="/s/{{ entry.subject.slug }}/">{{ entry.subject.title }}</a>
      </p>
      {{ entry.html | safe }}
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% elif not (blurbed | length) %}
    {% if view.members | length %}
  <p class="empty">Nothing written about these yet.</p>
    {% else %}
  <p class="empty">{{ emptyLabel }}</p>
    {% endif %}
  {% endif %}
</article>
