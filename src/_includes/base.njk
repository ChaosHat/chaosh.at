<!doctype html>
{#- Whose sky (2026-11-04): a daily's or an essay's page wears the night it
    was written — the masthead sheets, the frame colour and the wordmark, all
    from that date (eleventy.config.js `masthead`). Every other page gets
    today's, whose sheets are style.css's defaults, so `vars` is empty. -#}
{%- set sky = (page.date if isDaily else (essay.date if essay else null)) | masthead -%}
{#- The frame colour (aurora.js dayFrame): every panel, card and cover border
    is drawn in the masthead's hue. style.css derives --dim and --fill from it
    and keeps a lavender fallback for a build without one. -#}
<html lang="en" style="--frame:{{ sky.frame }};{{ sky.vars }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {#- 2026-11-11: the site is dark-only; without this classic scrollbars and form chrome render light. -#}
    <meta name="color-scheme" content="dark">
    <title>{% if title %}{{ title }} — {{ site.title }}{% elif isDaily %}{{ page.date | readableDate }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    {#- Link cards (2026-09-23): what a link unfurls into on Bluesky, Discord
        and the rest. linkCard hands back this page's description, its card
        (a daily's or essay's own, the site card for everything else, or none
        if even that failed to render), and the article fields. Rendering
        happens in the linkCards collection, before any page is written, so
        a failed card never ships as a dead URL. Every URL here is absolute
        (site.url carries no trailing slash): scrapers resolve nothing. -#}
    {%- set card = collections.linkCards | linkCard(page.url) -%}
    {#- card.title is the spoiler-stripped one: a card is as public as the feed. #}
    {%- set ogTitle = card.title or title or ((page.date | readableDate) if isDaily else site.title) -%}
    {%- set ogDesc = card.description or description or ((site.intro | replace("\n", " ")) if page.url == "/" else site.description) %}
    <meta name="description" content="{{ ogDesc }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:type" content="{{ card.type or 'website' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDesc }}">
    {%- if card.published %}
    <meta property="article:published_time" content="{{ card.published }}">
    {%- endif %}
    {#- Credits the post to the author's fediverse account when a Mastodon-style
        server unfurls it. The handle is site.yaml's fediverse profile
        (https://social.chaosh.at/@hat) on the account domain, which is the
        site's own: @hat@chaosh.at (webfinger.js). Not @posts, the bridged blog. -#}
    {%- if (isDaily or essay) and site.fediverse %}
    <meta name="fediverse:creator" content="@{{ site.fediverse.split('/@')[1] }}@{{ site.url | replace('https://', '') }}">
    {%- endif %}
    {%- if card.image %}
    <meta property="og:image" content="{{ site.url }}{{ card.image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {%- set ogAlt = card.alt or ogTitle %}
    <meta property="og:image:alt" content="{{ ogAlt }}{% if ogAlt != site.title %} — {{ site.title }}{% endif %}">
    <meta name="twitter:card" content="summary_large_image">
    {%- endif %}
    {#- Both faces are fetched alongside the stylesheet rather than discovered
        inside it. Pixel Operator Tight is 4KB and sets every page's chrome; Alegreya is
        17KB and sets every page's prose. Only the roman is preloaded of each:
        bold and italic are a minority of the glyphs on any page and can arrive
        a beat later, but the roman arriving late IS the flash. -#}
    <link rel="preload" href="/fonts/pixel-operator-tight-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/alegreya-sans-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="/css/style.css?v={{ cssVersion }}">
    {#- Each group's colour and icon, from site.yaml (groupStyle). -#}
    <style>{{ groupStyle | safe }}</style>
    {#- Two feeds (2026-11-03), in this order on every page: a reader's
        subscribe button takes the first alternate, and the first must be the
        whole blog, so nobody lands on the narrow one by accident. Titled so
        a reader that lists both shows "chaosh.at" and "chaosh.at · essays". -#}
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
    <link rel="alternate" type="application/atom+xml" href="/essays/feed.xml" title="{{ site.title }} · essays">
  </head>
  {#- Grid pages set `wide: true` in their front matter and let <main> take the
      whole shell; everything else gets the narrower, centred reading column.
      The header and the furniture strips are outside main either way, so they
      never change width as you navigate between the two kinds of page. -#}
  <body{% if wide %} class="wide"{% endif %}>
    {#- Skip link (2026-11-11): the first Tab stop, drawn only while focused.
        Absolutely positioned either way, so showing it moves nothing. -#}
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      {#- The name is the site button's wordmark (button.js), not set type:
          CHAOS·HAT with the dot at the word boundary. aria-label carries
          the domain for readers and crawlers. -#}
      <a class="site-title" href="/">{{ sky.wordmark | safe }}</a>
      {#- The logo row is the wordmark alone since 2026-11-02. The site's
          own pages (about · links · guestbook) sat top right as three panes
          from 2026-10-25; they're the last word of the media row now, on
          every width, as the phone already had them. The intro (what the
          auroras mean) sat under the wordmark, home page only, from
          2026-10-25 to 2026-11-02; it's in the footer now, every page. -#}

      {#- Now playing (2026-10-19), inside the header since 2026-11-04 (the
          header pass, layout C): beside the wordmark from 52rem, under it
          narrower, with the nav below. One row, label inline at the left
          (2026-11-02). It held a second row, latest essays, until 2026-11-04:
          essays are a tab now, and the signpost it was ("there is a
          second body of writing") is the tab's word on every page. Absent
          when nothing is playing. A neutral game window since 2026-10-25,
          not the day's frame: the same chrome as the media nav's window, in
          the muted lavender. -#}
      {%- set playing = collections.subjectPages | nowPlaying %}
      {%- if playing | length %}
      <div class="furniture win m-neutral"><div class="win-in">
        <div class="now playing">
          <span class="now-label">now playing</span>
          {#- The items are sorted by medium (nowPlaying) and the icon is drawn
              once per medium, at the head of its group, not on every title
              (2026-11-02): the row has to hold ten actives — a few games, a
              campaign, a show, a book — and an icon on each cost ~32px a title.
              The script at the end of the page turns this row into the ticker
              when it overflows. -#}
          <div class="now-items">
            {%- for item in playing %}
            <a class="now-item" href="/s/{{ item.slug }}/">{% if item.groupFirst %}<span class="mico m-{{ item.group }}" role="img" aria-label="{{ item.group | groupNoun }}"></span>{% endif %}{{ item.title }}</a>
            {%- endfor %}
          </div>
        </div>
      </div></div>
      {%- endif %}

      {#- The nav: one window. The tab row is one word per tabbed group
          (site.yaml `tabs:`, each once it has a subject), then etc (once an
          untabbed group has one), essays (once there is one; a fixed tab
          since 2026-11-04, when the latest-essays row left the panel), then
          about. Six tabs at most, and a promotion is a swap: the weakest tab
          drops into etc (the 360px phone fits six cells). Each word is a
          link to its page (2026-11-03: /<group>/, /etc/, /essays/, /about/) — it
          reverses 10-25's "tab opens, doesn't navigate", because there is
          now a page to go to — and the ▶ cursor marks the tab you're
          inside. Nothing is lit on the home page.

          The views appear only inside something (navState in
          eleventy.config.js): inside a group, tabbed or etc, they are the
          group's bands as words (canon · shelf · best of · log, each hidden
          until it has content); on /etc/, the etc groups; under essays, all
          · and each group with an essay; on the site's own pages, me ·
          links · guestbook · feed. An essay's page opens its group. Home,
          dailies, the archive, tags and ratings get none: the fold-height
          goal 11-02 started.
          Since 2026-11-04 they are their own window, popped out under the
          nav and overlapping its bottom edge, offset down and in — the FF
          "a new window opens" cascade — rather than a second row inside
          it. Folder tabs joined to a window from 2026-10-25 to 2026-11-02,
          radios that opened a window until 2026-11-03, a views row in the
          nav's frame until 2026-11-04 (Decisions, those dates). -#}
      {%- set gid = (group.id if group and group.id) or (subject.group if subject and subject.group) or (essay.group if essay and essay.group) or "" %}
      {%- set nav = collections.groupPages | navState(gid, page.url, navView) %}
      {%- set etcLive = collections.groupPages | rejectattr("tabbed") | list | length %}
      {%- set aboutUrl = "/about/" if collections.pages | length else "/links/" %}
      <nav class="media-nav win" aria-label="Sections"><div class="win-in">
        <ul class="media">
          {%- for m in tabs %}
          <li class="med m-{{ m.id }}"><a class="med-label{% if nav.tab == m.id %} is-open{% endif %}" href="{{ m.urls.home }}"{% if page.url == m.urls.home %} aria-current="page"{% endif %}><span class="mico" aria-hidden="true"></span><span class="med-word">{{ m.label }}</span></a></li>
          {%- endfor %}
          {%- if etcLive %}
          <li class="med m-etc"><a class="med-label{% if nav.tab == 'etc' %} is-open{% endif %}" href="/etc/"{% if page.url == '/etc/' %} aria-current="page"{% endif %}><span class="mico" aria-hidden="true"></span><span class="med-word">etc</span></a></li>
          {%- endif %}
          {%- if collections.essayPages | length %}
          <li class="med m-essays"><a class="med-label{% if nav.tab == 'essays' %} is-open{% endif %}" href="/essays/"{% if page.url == '/essays/' %} aria-current="page"{% endif %}><span class="mico" aria-hidden="true"></span><span class="med-word">essays</span></a></li>
          {%- endif %}
          <li class="med m-about med-about"><a class="med-label{% if nav.tab == 'about' %} is-open{% endif %}" href="{{ aboutUrl }}"><span class="mico" aria-hidden="true"></span><span class="med-word">about</span></a></li>
        </ul>
      </div></nav>
      {%- if nav.row == "list" and nav.items | length %}
      <nav class="views-pop win" aria-label="Views"><div class="win-in">
        <ul class="views">
          {%- for it in nav.items %}
          <li><a href="{{ it.url }}"{% if it.current %} aria-current="page"{% endif %}>{{ it.label }}</a></li>
          {%- endfor %}
        </ul>
      </div></nav>
      {%- elif nav.row == "about" %}
      <nav class="views-pop win" aria-label="About"><div class="win-in">
        <ul class="views">
          {% if collections.pages | length %}<li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>me</a></li>{% endif %}
          {% if collections.colophon | length %}<li><a href="/colophon/"{% if page.url == "/colophon/" %} aria-current="page"{% endif %}>colophon</a></li>{% endif %}
          <li><a href="/links/"{% if page.url == "/links/" %} aria-current="page"{% endif %}>links</a></li>
          <li><a href="/guestbook/"{% if page.url == "/guestbook/" %} aria-current="page"{% endif %}>guestbook</a></li>
          <li><a href="/feed.xml">feed</a></li>
        </ul>
      </div></nav>
      {%- endif %}
    </header>


    <main id="main" tabindex="-1">
      {{ content | safe }}
    </main>
    {#- The handle is the domain, so the link doubles as identity: rel="me"
        lets the Bluesky profile verify back to here, and the GoToSocial
        profile (@hat@chaosh.at) the same way. Both written in the vault's
        site.yaml; empty renders no link rather than a dead one.
        The footer is also the site's h-card, which Bridgy Fed reads off the
        home page to build the blog's own fediverse account. The hidden data
        carries what the visible footer doesn't say: the account's display
        name, its bio, and its username — acct:posts@chaosh.at, which
        functions/.well-known/webfinger.js must route to Bridgy. Permanent
        once anyone follows @posts. -#}
    <footer class="site-footer h-card">
      <data class="p-name" value="{{ site.title }}"></data>
      <data class="u-url" value="{{ site.url }}/"></data>
      <data class="u-url" value="acct:posts@chaosh.at"></data>
      <data class="p-note" value="{{ site.description }}"></data>
      {#- Says what the auroras mean. Written in the vault's site.yaml; empty
          renders nothing rather than a placeholder. In the footer since
          2026-11-02, every page: as a boxed paragraph in the header (home
          only) it was 114px on a desktop and 190px on a phone, the biggest
          single block before the writing. The 10-19 reason for keeping it
          (strangers have to learn the sky means something, and they land on
          posts, not About) is met here on every page, by the reader who has
          just finished one and is looking for who this is. Each line of the
          yaml block becomes its own span so the copy's line breaks survive
          into HTML. -#}
      {% if site.intro %}<p class="site-intro">{% for line in site.intro.split("\n") %}<span>{{ line }}</span>{% endfor %}</p>{% endif %}
      <p>{{ site.author }}</p>
      {% if site.bluesky %}<p><a href="https://bsky.app/profile/{{ site.bluesky }}" rel="me">bluesky</a></p>{% endif %}
      {% if site.fediverse %}<p><a href="{{ site.fediverse }}" rel="me">fediverse</a></p>{% endif %}
      <p><a href="/feed.xml">feed</a></p>
      {#- The IndieWeb Webring (2026-11-02), joined by signing in with the
          Bluesky handle. Their snippet as given: the ring now resolves
          neighbours from the Referer, so the links carry no member slug, and
          strict-origin-when-cross-origin still sends https://chaosh.at. Its
          checker wants both links on the homepage; the footer is on every
          page, so that's met. -#}
      <p><a href="https://xn--sr8hvo.ws/previous">&larr;</a> an <a href="https://xn--sr8hvo.ws">IndieWeb Webring</a> 🕸💍 <a href="https://xn--sr8hvo.ws/next">&rarr;</a></p>
      {#- Not By AI's "Written by Human" badge: true of every word of prose
          here; it makes no claim about the code. Their file,
          unmodified — their guidelines forbid altering it and set a 42px
          minimum height, so it's the one non-pixel object in the footer.
          Hosted, not hotlinked, like the friends' buttons. -#}
      <p class="footer-badge"><a href="https://notbyai.fyi"><img src="/img/buttons/written-by-human.svg" alt="Written by a Human, Not by AI" width="131" height="42"></a></p>
    </footer>
    {#- The now-playing ticker (2026-11-02). The row is a plain wrapping
        list without this. When the titles don't fit one line the script
        makes the row a sideways scroll box (.tick), doubles the items so
        the loop wraps seamlessly, and drifts it at SPEED px/s while nobody
        is touching it; a hand on it — hover, wheel, drag, touch, keyboard
        focus — takes over, and it resumes 3s after the last touch (0.8s
        after the pointer leaves). A mouse can scrub it: drag anywhere on
        the row (a drag of more than 6px swallows the click it would have
        landed on a title). A CSS marquee was rejected: it fights a reader
        scrolling by hand. Reduced-motion readers get the plain scroll row.
        The site's second script, after the lightbox. -#}
    <script>
      (() => {
        const SPEED = 24; /* px/s; 40 read as hurried (Hat, 2026-11-02) */
        const row = document.querySelector(".now.playing .now-items");
        if (!row || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const items = [...row.children];
        const track = document.createElement("div");
        track.className = "track";
        const copy = document.createElement("div");
        copy.className = "track";
        copy.setAttribute("aria-hidden", "true");
        let on = false, idle = 0, last = 0, lastAuto = 0, pos = 0, armedW = -1;
        const arm = () => {
          /* 2026-11-11: rebuilding moves every item, which resets the scroll
             and drops focus; keep both across it. */
          const sl = row.scrollLeft, focused = items.find((a) => a === document.activeElement);
          row.classList.add("tick");
          track.replaceChildren(...items);
          row.replaceChildren(track);
          if (track.scrollWidth <= row.clientWidth) {
            row.classList.remove("tick");
            row.replaceChildren(...items);
            on = false;
          } else {
            /* tabindex -1: the aria-hidden copy is for the loop's look only; keyboard users get the row once. */
            copy.replaceChildren(...items.map((a) => { const c = a.cloneNode(true); c.tabIndex = -1; return c; }));
            row.append(copy);
            row.scrollLeft = sl % track.offsetWidth;
            pos = row.scrollLeft;
            on = true;
          }
          armedW = row.clientWidth;
          if (focused) focused.focus({ preventScroll: true });
        };
        const hold = (ms) => { idle = performance.now() + ms; };
        for (const e of ["pointerenter", "pointerdown", "wheel", "touchstart", "focusin"]) row.addEventListener(e, () => hold(3000), { passive: true });
        row.addEventListener("pointerleave", () => hold(800));
        row.addEventListener("scroll", () => { if (performance.now() - lastAuto > 100) { hold(3000); pos = row.scrollLeft; } }, { passive: true });
        let drag = null;
        row.addEventListener("pointerdown", (e) => {
          if (e.pointerType !== "mouse" || e.button !== 0) return;
          drag = { x: e.clientX, left: row.scrollLeft, moved: false };
        });
        row.addEventListener("pointermove", (e) => {
          if (!drag) return;
          const dx = e.clientX - drag.x;
          if (Math.abs(dx) > 6) { drag.moved = true; row.setPointerCapture(e.pointerId); row.classList.add("scrub"); }
          if (drag.moved) { row.scrollLeft = drag.left - dx; hold(3000); }
        });
        const drop = () => { if (drag?.moved) setTimeout(() => row.classList.remove("scrub"), 0); drag = null; };
        row.addEventListener("pointerup", drop);
        row.addEventListener("pointercancel", drop);
        row.addEventListener("click", (e) => { if (row.classList.contains("scrub")) e.preventDefault(); }, true);
        const step = (now) => {
          if (on && now > idle) {
            const w = track.offsetWidth;
            pos += Math.min(50, now - last) * SPEED / 1000;
            if (pos >= w) pos -= w;
            lastAuto = now;
            row.scrollLeft = pos;
          }
          last = now;
          requestAnimationFrame(step);
        };
        arm();
        addEventListener("resize", () => { if (row.clientWidth !== armedW) arm(); }); /* 2026-11-11: height-only resizes (a phone's URL bar) rebuilt the row and jumped it back */
        requestAnimationFrame(step);
      })();
    </script>
    {#- Lightbox: click a post image to see it full size. Without it the
        images are just images.
        2026-11-11: a column image is its 640px thumbnail (eleventy.config.js,
        "post images"); data-full is the published file, and that is what the
        box shows. Until it arrives the box shows the thumbnail, already
        loaded, stretched to the full file's final size so nothing jumps; the
        size lock goes once the full file is in. The src is cleared first so
        the last image opened never shows under this one's caption. A figure
        without data-full (|full, or no thumbnail) opens its own src as
        before. -#}
    <script>
      document.querySelector("main figure img") && (() => {
        const box = document.createElement("dialog");
        box.className = "lightbox";
        box.setAttribute("aria-label", "Image viewer");
        const big = document.createElement("img");
        const cap = document.createElement("p");
        cap.className = "lightbox-cap";
        box.append(big, cap);
        document.body.append(box);
        box.addEventListener("click", () => box.close());
        big.addEventListener("load", () => {
          if (big.naturalWidth === +big.dataset.fw) big.style.width = big.style.height = "";
        });
        /* 2026-11-11: keyboard path. Each figure image becomes a button
           (Tab, Enter or Space to open), Esc closes the dialog natively, and
           focus goes back to the image that opened it. */
        let trigger = null;
        for (const im of document.querySelectorAll("main figure img")) {
          im.tabIndex = 0;
          im.setAttribute("role", "button");
          im.setAttribute("aria-label", im.alt ? "Enlarge image: " + im.alt : "Enlarge image");
        }
        box.addEventListener("close", () => { if (trigger) trigger.focus(); trigger = null; });
        const main = document.querySelector("main");
        main.addEventListener("keydown", (e) => {
          if ((e.key === "Enter" || e.key === " ") && e.target.matches("figure img")) { e.preventDefault(); e.target.click(); }
        });
        main.addEventListener("click", (e) => {
          const img = e.target.closest("figure img");
          if (!img) return;
          trigger = img;
          box.setAttribute("aria-label", img.alt ? "Image: " + img.alt : "Image viewer");
          /* 2026-11-11: the full file, the thumbnail standing in meanwhile */
          const full = img.dataset.full;
          const fw = +img.dataset.fullWidth, fh = +img.dataset.fullHeight;
          big.removeAttribute("src");
          big.style.width = big.style.height = "";
          big.dataset.fw = full ? fw : "";
          if (full && fw && fh) {
            const s = Math.min(1, innerWidth * 0.94 / fw, innerHeight * 0.84 / fh);
            big.style.width = Math.floor(fw * s) + "px";
            big.style.height = Math.floor(fh * s) + "px";
            big.src = img.currentSrc || img.src;
          }
          big.src = full || img.currentSrc || img.src;
          big.alt = img.alt;
          const fc = img.closest("figure").querySelector("figcaption");
          cap.innerHTML = fc ? fc.innerHTML : "";
          cap.hidden = !fc;
          box.showModal();
        });
      })();
    </script>
  </body>
</html>
