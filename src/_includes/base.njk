<!doctype html>
{#- The day's frame colour (aurora.js dayFrame): every panel, card and cover
    border is drawn in the masthead's hue. style.css derives --dim and --fill
    from it and keeps a lavender fallback for a build without one. -#}
<html lang="en"{% if frame %} style="--frame:{{ frame }}"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} — {{ site.title }}{% elif isDaily %}{{ page.date | readableDate }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    {#- Link cards (2026-09-23): what a link unfurls into on Bluesky, Discord
        and the rest. linkCard hands back this page's description, its card
        (a daily's or essay's own, the site card for everything else, or none
        if even that failed to render), and the article fields. Rendering
        happens in the linkCards collection, before any page is written, so
        a failed card never ships as a dead URL. Every URL here is absolute
        (site.url carries no trailing slash): scrapers resolve nothing. -#}
    {%- set card = collections.linkCards | linkCard(page.url) -%}
    {#- card.title is the spoiler-stripped one: a card is as public as the feed. #}
    {%- set ogTitle = card.title or title or ((page.date | readableDate) if isDaily else site.title) -%}
    {%- set ogDesc = card.description or description or ((site.intro | replace("\n", " ")) if page.url == "/" else site.description) %}
    <meta name="description" content="{{ ogDesc }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:type" content="{{ card.type or 'website' }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:title" content="{{ ogTitle }}">
    <meta property="og:description" content="{{ ogDesc }}">
    {%- if card.published %}
    <meta property="article:published_time" content="{{ card.published }}">
    {%- endif %}
    {%- if card.image %}
    <meta property="og:image" content="{{ site.url }}{{ card.image }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {%- set ogAlt = card.alt or ogTitle %}
    <meta property="og:image:alt" content="{{ ogAlt }}{% if ogAlt != site.title %} — {{ site.title }}{% endif %}">
    <meta name="twitter:card" content="summary_large_image">
    {%- endif %}
    {#- Both faces are fetched alongside the stylesheet rather than discovered
        inside it. Pixel Operator Tight is 4KB and sets every page's chrome; Alegreya is
        17KB and sets every page's prose. Only the roman is preloaded of each:
        bold and italic are a minority of the glyphs on any page and can arrive
        a beat later, but the roman arriving late IS the flash. -#}
    <link rel="preload" href="/fonts/pixel-operator-tight-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/alegreya-sans-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="stylesheet" href="/css/style.css">
    {#- Which window the checked tab shows: one line per medium, generated
        so a medium added to site.yaml needs no CSS edit. See style.css →
        "the media nav". -#}
    <style>{% for m in collections.mediumPages %}.media-nav:has(#mt-{{ m.id }}:checked) .f-{{ m.id }}{display:flex}{% endfor %}.media-nav:has(#mt-about:checked) .f-about{display:flex}</style>
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  </head>
  {#- Grid pages set `wide: true` in their front matter and let <main> take the
      whole shell; everything else gets the narrower, centred reading column.
      The header and the furniture strips are outside main either way, so they
      never change width as you navigate between the two kinds of page. -#}
  <body{% if wide %} class="wide"{% endif %}>
    <header class="site-header">
      {#- The name is the site button's wordmark (button.js), not set type:
          CHAOS·HAT with the dot at the word boundary. aria-label carries
          the domain for readers and crawlers. -#}
      <a class="site-title" href="/">{{ wordmark | safe }}</a>
      {#- The logo row is the wordmark alone since 2026-11-02. The site's
          own pages (about · links · guestbook) sat top right as three panes
          from 2026-10-25; they're the last word of the media row now, on
          every width, as the phone already had them. The intro (what the
          auroras mean) sat under the wordmark, home page only, from
          2026-10-25 to 2026-11-02; it's in the footer now, every page. -#}

      {#- The media nav: one window, two rows. The media row is one word per
          medium that is switched on in site.yaml and has a subject, games
          first, then about; the ▶ cursor marks the open one. Under a rule,
          the open medium's views. A view only appears once it has something
          in it, the same rule as the media. Drawn in style.css → "media nav".

          A medium word opens its views; it doesn't navigate (Hat,
          2026-10-25: "Tab opens the window is correct"). Like a game menu,
          picking the medium shows what's inside, and picking a view is the
          second press. No script: each medium is a radio and its label, and
          the checked radio decides which views list shows (style.css, plus
          the per-medium lines in <head>). The page's own medium starts
          checked: games wherever a page isn't about one medium, the home
          page included; about on the site's own pages.
          Folder tabs joined to a window from 2026-10-25 to 2026-11-02; the
          cursor row replaced them (Decisions, 2026-11-02). -#}
      {%- set onAbout = page.url == "/about/" or page.url == "/links/" or page.url == "/guestbook/" %}
      {%- set openId = ((medium.id if medium and medium.id) or (subject.medium if subject and subject.medium) or "") | openMedium %}
      {%- set onView = navView and medium %}
      {%- if collections.mediumPages | length %}
      <nav class="media-nav win" aria-label="Sections"><div class="win-in">
        <ul class="media">
          {%- for m in collections.mediumPages %}
          <li class="med m-{{ m.id }}">
            <input type="radio" name="media-tab" id="mt-{{ m.id }}" class="mt-radio" aria-label="{{ m.label }}"{% if m.id == openId and not onAbout %} checked{% endif %}>
            <label for="mt-{{ m.id }}" class="med-label"><span class="mico" aria-hidden="true"></span><span class="med-word">{{ m.label }}</span></label>
          </li>
          {%- endfor %}
          <li class="med m-about med-about">
            <input type="radio" name="media-tab" id="mt-about" class="mt-radio" aria-label="about"{% if onAbout %} checked{% endif %}>
            <label for="mt-about" class="med-label"><span class="mico" aria-hidden="true"></span><span class="med-word">about</span></label>
          </li>
        </ul>
        {%- for m in collections.mediumPages %}
        {%- set u = m.urls %}
        {%- set here = onView and medium.id == m.id %}
        <ul class="views f-{{ m.id }}{% if m.id == openId and not onAbout %} f-default{% endif %}">
          {% if m.canon.members | length %}<li><a href="{{ u.canon }}"{% if here and navView == "canon" %} aria-current="page"{% endif %}>canon</a></li>{% endif %}
          <li><a href="{{ u.shelf }}"{% if here and navView == "shelf" %} aria-current="page"{% endif %}>shelf</a></li>
          {% if m.featured | length %}<li><a href="{{ u.best }}"{% if here and navView == "best" %} aria-current="page"{% endif %}>best of</a></li>{% endif %}
          {% if m.essays | length %}<li><a href="{{ u.essays }}"{% if here and navView == "essays" %} aria-current="page"{% endif %}>essays</a></li>{% endif %}
          {% if m.log | length %}<li><a href="{{ u.log }}"{% if here and navView == "log" %} aria-current="page"{% endif %}>log</a></li>{% endif %}
        </ul>
        {%- endfor %}
        <ul class="views f-about{% if onAbout %} f-default{% endif %}">
          {% if collections.pages | length %}<li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>me</a></li>{% endif %}
          <li><a href="/links/"{% if page.url == "/links/" %} aria-current="page"{% endif %}>links</a></li>
          <li><a href="/guestbook/"{% if page.url == "/guestbook/" %} aria-current="page"{% endif %}>guestbook</a></li>
          <li><a href="/feed.xml">feed</a></li>
        </ul>
      </div></nav>
      {%- endif %}
    </header>


    {#- One framed panel holds both rows since 2026-10-19 (the "too loud?"
        pass): two frames stacked edge to edge read as two more boxes, and
        both rows say the same kind of thing, what's current. Each row is one
        line since 2026-11-02, label inline at the left: with the label on
        its own line the panel ran ~200px and the day's first words started
        ~575px down at 1280 (below the fold on a phone). -#}
    {% set playing = collections.subjectPages | nowPlaying %}
    {% set essays = collections.essayPages | sort(true, false, "date") %}
    {% set showEssays = essays | length and page.url != "/essays/" %}
    {% if playing | length or showEssays %}
    {#- A neutral game window since 2026-10-25, not the day's frame: the
        same chrome as the media nav's window, in the muted lavender. -#}
    <div class="furniture win m-neutral"><div class="win-in">
    {% if playing | length %}
    <div class="now playing">
      <span class="now-label">now playing</span>
      {#- The items are sorted by medium (nowPlaying) and the icon is drawn
          once per medium, at the head of its group, not on every title
          (2026-11-02): the row has to hold ten actives — a few games, a
          campaign, a show, a book — and an icon on each cost ~32px a title.
          The script at the end of the page turns this row into the ticker
          when it overflows. -#}
      <div class="now-items">
        {% for item in playing %}
        <a class="now-item" href="/s/{{ item.slug }}/">{% if item.groupFirst %}<span class="mico m-{{ item.medium }}" role="img" aria-label="{{ item.medium | mediumNoun }}"></span>{% endif %}{{ item.title }}</a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {#- The essays signpost. Essays are rare, so recency is the wrong axis —
        the strip exists so a visitor learns the second body of writing is
        there at all, and it is furniture, so it does not go stale between
        essays. The chip is the first cited subject's; an essay that cites
        only tags gets its first tag's chip (eleventy.config.js tagChip). Not on /essays/ itself: the list right
        under it already leads with the same two (2026-10-14). Labelled
        "latest essays" since 2026-11-02 (was "latest deep thoughts"): the
        nav says essays, and two names for one thing read as two doors.
        "Deep thoughts" is the /essays/ page's own heading. -#}
    {% if showEssays %}
    <div class="now essays">
      <span class="now-label">latest essays</span>
      <div class="now-items">
        {% for e in essays | limit(2) %}
        <a class="now-item" href="{{ e.url }}">{% if e.chipUrl %}<span class="sky" style="background-image:url({{ e.chipUrl }})" aria-hidden="true"></span>{% endif %}<span class="essay-t">{{ e.title }}</span><span class="essay-when">{{ e.date | shortDate }}</span></a>
        {% endfor %}
      </div>
      <a class="essays-all" href="/essays/">all →</a>
    </div>
    {% endif %}
    </div></div>
    {% endif %}

    <main>
      {{ content | safe }}
    </main>
    {#- The handle is the domain, so the link doubles as identity: rel="me"
        lets the Bluesky profile verify back to here, and the GoToSocial
        profile (@hat@chaosh.at) the same way. Both written in the vault's
        site.yaml; empty renders no link rather than a dead one.
        The footer is also the site's h-card, which Bridgy Fed reads off the
        home page to build the blog's own fediverse account. The hidden data
        carries what the visible footer doesn't say: the account's display
        name, its bio, and its username — acct:posts@chaosh.at, which
        functions/.well-known/webfinger.js must route to Bridgy. Permanent
        once anyone follows @posts. -#}
    <footer class="site-footer h-card">
      <data class="p-name" value="{{ site.title }}"></data>
      <data class="u-url" value="{{ site.url }}/"></data>
      <data class="u-url" value="acct:posts@chaosh.at"></data>
      <data class="p-note" value="{{ site.description }}"></data>
      {#- Says what the auroras mean. Written in the vault's site.yaml; empty
          renders nothing rather than a placeholder. In the footer since
          2026-11-02, every page: as a boxed paragraph in the header (home
          only) it was 114px on a desktop and 190px on a phone, the biggest
          single block before the writing. The 10-19 reason for keeping it
          (strangers have to learn the sky means something, and they land on
          posts, not About) is met here on every page, by the reader who has
          just finished one and is looking for who this is. Each line of the
          yaml block becomes its own span so the copy's line breaks survive
          into HTML. -#}
      {% if site.intro %}<p class="site-intro">{% for line in site.intro.split("\n") %}<span>{{ line }}</span>{% endfor %}</p>{% endif %}
      <p>{{ site.author }}</p>
      {% if site.bluesky %}<p><a href="https://bsky.app/profile/{{ site.bluesky }}" rel="me">bluesky</a></p>{% endif %}
      {% if site.fediverse %}<p><a href="{{ site.fediverse }}" rel="me">fediverse</a></p>{% endif %}
      <p><a href="/feed.xml">feed</a></p>
      {#- Not By AI's "Written by Human" badge: true of every word of prose
          here; it makes no claim about the code. Their file,
          unmodified — their guidelines forbid altering it and set a 42px
          minimum height, so it's the one non-pixel object in the footer.
          Hosted, not hotlinked, like the friends' buttons. -#}
      <p class="footer-badge"><a href="https://notbyai.fyi"><img src="/img/buttons/written-by-human.svg" alt="Written by a Human, Not by AI" width="131" height="42"></a></p>
    </footer>
    {#- The now-playing ticker (2026-11-02). The row is a plain wrapping
        list without this. When the titles don't fit one line the script
        makes the row a sideways scroll box (.tick), doubles the items so
        the loop wraps seamlessly, and drifts it at SPEED px/s while nobody
        is touching it; a hand on it — hover, wheel, drag, touch, keyboard
        focus — takes over, and it resumes 3s after the last touch (0.8s
        after the pointer leaves). A mouse can scrub it: drag anywhere on
        the row (a drag of more than 6px swallows the click it would have
        landed on a title). A CSS marquee was rejected: it fights a reader
        scrolling by hand. Reduced-motion readers get the plain scroll row.
        The site's second script, after the lightbox. -#}
    <script>
      (() => {
        const SPEED = 24; /* px/s; 40 read as hurried (Hat, 2026-11-02) */
        const row = document.querySelector(".now.playing .now-items");
        if (!row || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const items = [...row.children];
        const track = document.createElement("div");
        track.className = "track";
        const copy = document.createElement("div");
        copy.className = "track";
        copy.setAttribute("aria-hidden", "true");
        let on = false, idle = 0, last = 0, lastAuto = 0, pos = 0;
        const arm = () => {
          row.classList.add("tick");
          track.replaceChildren(...items);
          row.replaceChildren(track);
          if (track.scrollWidth <= row.clientWidth) {
            row.classList.remove("tick");
            row.replaceChildren(...items);
            on = false;
            return;
          }
          copy.replaceChildren(...items.map((a) => a.cloneNode(true)));
          row.append(copy);
          pos = row.scrollLeft;
          on = true;
        };
        const hold = (ms) => { idle = performance.now() + ms; };
        for (const e of ["pointerenter", "pointerdown", "wheel", "touchstart", "focusin"]) row.addEventListener(e, () => hold(3000), { passive: true });
        row.addEventListener("pointerleave", () => hold(800));
        row.addEventListener("scroll", () => { if (performance.now() - lastAuto > 100) { hold(3000); pos = row.scrollLeft; } }, { passive: true });
        let drag = null;
        row.addEventListener("pointerdown", (e) => {
          if (e.pointerType !== "mouse" || e.button !== 0) return;
          drag = { x: e.clientX, left: row.scrollLeft, moved: false };
        });
        row.addEventListener("pointermove", (e) => {
          if (!drag) return;
          const dx = e.clientX - drag.x;
          if (Math.abs(dx) > 6) { drag.moved = true; row.setPointerCapture(e.pointerId); row.classList.add("scrub"); }
          if (drag.moved) { row.scrollLeft = drag.left - dx; hold(3000); }
        });
        const drop = () => { if (drag?.moved) setTimeout(() => row.classList.remove("scrub"), 0); drag = null; };
        row.addEventListener("pointerup", drop);
        row.addEventListener("pointercancel", drop);
        row.addEventListener("click", (e) => { if (row.classList.contains("scrub")) e.preventDefault(); }, true);
        const step = (now) => {
          if (on && now > idle) {
            const w = track.offsetWidth;
            pos += Math.min(50, now - last) * SPEED / 1000;
            if (pos >= w) pos -= w;
            lastAuto = now;
            row.scrollLeft = pos;
          }
          last = now;
          requestAnimationFrame(step);
        };
        arm();
        addEventListener("resize", arm);
        requestAnimationFrame(step);
      })();
    </script>
    {#- Lightbox: click a post image to see it full size. Without it the
        images are just images. -#}
    <script>
      document.querySelector("main figure img") && (() => {
        const box = document.createElement("dialog");
        box.className = "lightbox";
        const big = document.createElement("img");
        const cap = document.createElement("p");
        cap.className = "lightbox-cap";
        box.append(big, cap);
        document.body.append(box);
        box.addEventListener("click", () => box.close());
        document.querySelector("main").addEventListener("click", (e) => {
          const img = e.target.closest("figure img");
          if (!img) return;
          big.src = img.currentSrc || img.src;
          big.alt = img.alt;
          const fc = img.closest("figure").querySelector("figcaption");
          cap.innerHTML = fc ? fc.innerHTML : "";
          cap.hidden = !fc;
          box.showModal();
        });
      })();
    </script>
  </body>
</html>
