<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} — {{ site.title }}{% elif isDaily %}{{ page.date | readableDate }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    {#- The face is 8KB and every page's chrome is set in it, so it is fetched
        alongside the stylesheet rather than discovered inside it. -#}
    <link rel="preload" href="/fonts/silkscreen-400.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">{{ site.title }}</a>
      <nav class="site-nav">
        {% for shelf in collections.shelves %}
        <a href="/shelf/{{ shelf.category }}/">{{ shelf.label }}</a>
        {% endfor %}
        <a href="/archive/">archive</a>
        <a href="/feed.xml">feed</a>
        {% if collections.featured | length %}<a href="/best/">best of</a>{% endif %}
      </nav>
    </header>

    {% set playing = collections.subjectPages | nowPlaying %}
    {% if playing | length %}
    <div class="now">
      <span class="now-label">now playing</span>
      <div class="now-items">
        {% for item in playing %}
        <a class="now-item" href="/s/{{ item.slug }}/"><span class="sky" style="background-image:url({{ item.chipUrl }})" aria-hidden="true"></span>{{ item.title }}</a>
        {% endfor %}
      </div>
    </div>
    {% endif %}

    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{{ site.author }}</p>
    </footer>
  </body>
</html>
