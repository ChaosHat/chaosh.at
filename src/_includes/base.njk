<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} — {{ site.title }}{% elif isDaily %}{{ page.date | readableDate }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    <meta name="description" content="{{ description or site.description }}">
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">{{ site.title }}</a>
      <nav class="site-nav">
        {% for shelf in collections.shelves %}
        <a href="/shelf/{{ shelf.category }}/">{{ shelf.label }}</a>
        {% endfor %}
        <a href="/archive/">archive</a>
        {% if collections.featured | length %}<a href="/best/">best of</a>{% endif %}
      </nav>
    </header>

    {% set playing = collections.subjectPages | nowPlaying %}
    {% if playing | length %}
    <p class="now-playing">
      <span class="now-label">Now playing</span>
      {% for item in playing %}<a href="/s/{{ item.slug }}/">{{ item.title }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </p>
    {% endif %}

    <main>
      {{ content | safe }}
    </main>
    <footer class="site-footer">
      <p>{{ site.author }}</p>
    </footer>
  </body>
</html>
