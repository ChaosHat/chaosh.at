---
layout: base.njk
---
<article class="post h-entry">
  {#- No band since 2026-11-04: the masthead above is this post's sky. -#}
  <header class="post-head">
    {% if title %}
    <h1 class="post-title p-name">{{ title }}</h1>
    <p class="post-subdate"><time class="dt-published" datetime="{{ page.date | dateSlug }}">{{ page.date | readableDate }}</time></p>
    {% else %}
    <h1 class="post-date p-name"><time class="dt-published" datetime="{{ page.date | dateSlug }}">{{ page.date | readableDate }}</time></h1>
    {% endif %}
    {#- h-entry's url and author, as hidden data like the footer's h-card:
        there is no permalink link on the page to annotate, and the author is
        the h-card in base.njk's footer (its u-url is the home page). -#}
    <data class="u-url" value="{{ site.url }}{{ page.url }}"></data>
    <data class="u-author" value="{{ site.url }}/"></data>
  </header>
  {#- linkSubjects(true): each section gets its anchor (eleventy.config.js,
      sectionAnchors), on this page only. -#}
  {{ content | linkSubjects(true) | spoilers | safe }}
  {#- Day-scoped: the union of the tags of every subject this post files to.
      Only on the full post — the home page shows truncated bodies, where a
      footer covering sections that were cut would be a lie. -#}
  {% set dayTags = content | postTags %}
  {% if dayTags | length %}
  <p class="tag-list post-tags">
    {% for tag in dayTags %}<a class="tag-link" href="/t/{{ tag.slug }}/">#{{ tag.slug }}</a>{% endfor %}
  </p>
  {% endif %}
  {#- Other days (2026-11-11): the neighbours in the published dailies
      collection, which is newest first, so Eleventy's "next" item is the
      OLDER day. A held or future day is not in it, so never linked. -#}
  {% set olderDay = collections.dailies | getNextCollectionItem(page) %}
  {% set newerDay = collections.dailies | getPreviousCollectionItem(page) %}
  {% if olderDay or newerDay %}
  <nav class="day-nav" aria-label="Other days">
    {% if olderDay %}<a class="day-prev" rel="prev" href="{{ olderDay.url }}"><span class="day-nav-date">← <span class="day-nav-long">{{ olderDay.date | readableDate }}</span><span class="day-nav-short">{{ olderDay.date | shortDate }}</span></span>{% if olderDay.data.title %}<span class="day-nav-title">{{ olderDay.data.title }}</span>{% endif %}</a>{% endif %}
    {% if newerDay %}<a class="day-next" rel="next" href="{{ newerDay.url }}"><span class="day-nav-date"><span class="day-nav-long">{{ newerDay.date | readableDate }}</span><span class="day-nav-short">{{ newerDay.date | shortDate }}</span> →</span>{% if newerDay.data.title %}<span class="day-nav-title">{{ newerDay.data.title }}</span>{% endif %}</a>{% endif %}
  </nav>
  {% endif %}
</article>
