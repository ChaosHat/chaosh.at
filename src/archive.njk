---
layout: base.njk
pagination:
  data: collections.stream
  size: 20
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/archive/{% else %}/archive/page-{{ pagination.pageNumber + 1 }}/{% endif %}"
eleventyComputed:
  title: "Archive{% if pagination.pageNumber > 0 %}, page {{ pagination.pageNumber + 1 }}{% endif %}"
---
{#- Each page its own <title> (2026-11-11); all six were "Archive". -#}
<h1>Archive</h1>

<ul class="archive-list">
  {% for entry in posts %}
  {% if entry.kind == "essay" %}
  <li>
    <a href="{{ entry.essay.url }}">{{ entry.essay.title }}</a>
    <span class="archive-kind">deep thoughts</span>
    <span class="archive-note">{{ entry.date | readableDate }}</span>
  </li>
  {% else %}
  {% set post = entry.post %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title or (post.date | readableDate) }}</a>
    {% if post.data.title %}<span class="archive-note">{{ post.date | readableDate }}</span>{% endif %}
  </li>
  {% endif %}
  {% endfor %}
</ul>

{#- The views' pager since 2026-11-11 (pager.njk), so there is one. -#}
{%- set pager = {
  number: pagination.pageNumber + 1,
  total: pagination.pages | length,
  first: "/archive/",
  previous: pagination.href.previous,
  next: pagination.href.next
} %}
{% include "pager.njk" %}
