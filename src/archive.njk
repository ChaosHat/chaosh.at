---
layout: base.njk
title: Archive
pagination:
  data: collections.dailies
  size: 20
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/archive/{% else %}/archive/page-{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<h1>Archive</h1>

{% set essays = collections.subjectPages | withEssays %}
{% if pagination.pageNumber == 0 and essays | length %}
<h2 class="section-head">Writing</h2>
<ul class="archive-list">
  {% for essay in essays %}
  <li>
    <a href="/s/{{ essay.slug }}/">{{ essay.title }}</a>
    <span class="archive-note">essay</span>
  </li>
  {% endfor %}
</ul>
<h2 class="section-head">Daily posts</h2>
{% endif %}

<ul class="archive-list">
  {% for post in posts %}
  <li>
    <a href="{{ post.url }}">{{ post.data.title or (post.date | readableDate) }}</a>
    {% if post.data.title %}<span class="archive-note">{{ post.date | readableDate }}</span>{% endif %}
  </li>
  {% endfor %}
</ul>

{% if pagination.href.previous or pagination.href.next %}
<nav class="pagination">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← newer</a>{% endif %}
  <span>{{ pagination.pageNumber + 1 }} / {{ pagination.pages | length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next }}">older →</a>{% endif %}
</nav>
{% endif %}
