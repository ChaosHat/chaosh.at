---
layout: base.njk
pagination:
  data: collections.subjectPages
  size: 1
  alias: subject
permalink: "/s/{{ subject.slug }}/"
eleventyComputed:
  title: "{{ subject.title }}"
---
<article class="subject">
  <header class="subject-head">
    {#- The subject's sky at the one size where the full three-curtain scene
        is properly legible. Small renders elsewhere use the chip variant. -#}
    <span class="sky" style="background-image:url({{ subject.skyUrl }})" aria-hidden="true"></span>
    <div>
      <h1>{{ subject.title }}</h1>
      <p class="subject-meta">
        <span class="badge b-{{ subject.status }}">{{ subject.status }}</span>
        {% if subject.rating %}<span class="rating">{{ subject.rating }}/5</span>{% endif %}
        {#- Sidestepping to the franchise or the genre is the natural next move
            for a reader who arrived by following a title, so the tags sit in the
            meta row rather than at the foot of a long timeline. -#}
        {% if subject.tags | length %}
        <span class="tag-list">
          {% for tag in subject.tags %}<a class="tag-link" href="/t/{{ tag.slug }}/">#{{ tag.slug }}</a>{% endfor %}
        </span>
        {% endif %}
      </p>
    </div>
  </header>

  {#- One chronological stream: everything written about this thing, in order.
      Fragments render in full; an essay appears at its date as lede + link,
      because its full text has exactly one home — its own /e/ page. -#}
  {% if subject.entries | length %}
  <section class="timeline">
    {% for entry in subject.entries %}
    <div class="fragment">
      {% if entry.kind == "essay" %}
      <p class="fragment-meta">
        <a class="fragment-date" href="{{ entry.url }}">{{ entry.date | readableDate }}</a>
        <a class="fragment-subject" href="{{ entry.url }}">{{ entry.title }}</a>
      </p>
      <p class="tag-essay">{{ entry.blurb }}
        <a class="more" href="{{ entry.url }}">read →</a>
      </p>
      {% else %}
      <a class="fragment-date" href="{{ entry.url }}">{{ entry.date | readableDate }}</a>
      {{ entry.html | safe }}
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% else %}
  <p class="empty">Nothing written about this yet.</p>
  {% endif %}
</article>
