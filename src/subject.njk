---
layout: base.njk
pagination:
  data: collections.subjectPages
  size: 1
  alias: subject
permalink: "/s/{{ subject.slug }}/"
eleventyComputed:
  title: "{{ subject.title }}"
---
<article class="subject">
  <header class="subject-head">
    {#- The subject's sky at the one size where the full three-curtain scene
        is properly legible. Small renders elsewhere use the chip variant. -#}
    <span class="sky" style="background-image:url({{ subject.skyUrl }})" aria-hidden="true"></span>
    <div>
      <h1>{{ subject.title }}</h1>
      <p class="subject-meta">
        <span class="badge b-{{ subject.status }}">{{ subject.status }}</span>
        {% if subject.rating %}<span class="rating">{{ subject.rating }}/5</span>{% endif %}
        {#- Sidestepping to the franchise or the genre is the natural next move
            for a reader who arrived by following a title, so the tags sit in the
            meta row rather than at the foot of a long timeline. -#}
        {% if subject.tags | length %}
        <span class="tag-list">
          {% for tag in subject.tags %}<a class="tag-link" href="/t/{{ tag.slug }}/">#{{ tag.slug }}</a>{% endfor %}
        </span>
        {% endif %}
      </p>
    </div>
  </header>

  {% if subject.essayHtml %}
  <div class="essay">{{ subject.essayHtml | safe }}{% if (subject.cites | length) or (subject.citedTags | length) %}
    {#- The essay-shaped mirror of a daily's tag footer: cited subjects first
        (about-list order), then the union of their tags. Reuses tag-list/
        tag-link rather than inventing a look for a row that is the same idea. -#}
    <p class="tag-list">
      {% for c in subject.cites %}<a class="tag-link" href="/s/{{ c.slug }}/">{{ c.title }}</a>{% endfor %}
      {% for t in subject.citedTags %}<a class="tag-link" href="/t/{{ t.slug }}/">#{{ t.slug }}</a>{% endfor %}
    </p>
  {% endif %}</div>
  {% endif %}

  {%- if subject.citedBy | length %}

  {#- Essays that cite THIS subject via about: without being about it
      themselves. Lede + link only — full text lives on the essay's own page,
      mirroring how an essay appears on a tag page. -#}
  <section class="cited-by">
    <h2 class="timeline-head">Essays that mention this</h2>
    {% for entry in subject.citedBy %}
    <p class="tag-essay">{{ entry.blurb }}
      <a class="more" href="{{ entry.url }}">read →</a>
    </p>
    {% endfor %}
  </section>
  {% endif %}

  {% if subject.fragments | length %}
  <section class="timeline">
    {% if subject.essayHtml %}<h2 class="timeline-head">Along the way</h2>{% endif %}
    {% for fragment in subject.fragments %}
    <div class="fragment">
      <a class="fragment-date" href="{{ fragment.sourceUrl }}">{{ fragment.date | readableDate }}</a>
      {{ fragment.html | safe }}
    </div>
    {% endfor %}
  </section>
  {% elif not subject.essayHtml and not (subject.citedBy | length) %}
  <p class="empty">Nothing written about this yet.</p>
  {% endif %}
</article>
