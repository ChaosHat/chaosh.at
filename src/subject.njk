---
layout: base.njk
pagination:
  data: collections.subjectPages
  size: 1
  alias: subject
permalink: "/s/{{ subject.slug }}/"
eleventyComputed:
  title: "{{ subject.title }}"
---
<article class="subject">
  <header class="subject-head">
    {#- The subject's sky at the one size where the time of day is properly
        legible. In the stream it renders at 48px, where it reads as an identity
        chip and little else. -#}
    <span class="sky t-{{ subject.status }}" style="--h:{{ subject.hue }}deg" aria-hidden="true"></span>
    <div>
      <h1>{{ subject.title }}</h1>
      <p class="subject-meta">
        <span class="badge b-{{ subject.status }}">{{ subject.status }}</span>
        {% if subject.rating %}<span class="rating">{{ subject.rating }}/5</span>{% endif %}
        {#- Sidestepping to the franchise or the genre is the natural next move
            for a reader who arrived by following a title, so the tags sit in the
            meta row rather than at the foot of a long timeline. -#}
        {% if subject.tags | length %}
        <span class="tag-list">
          {% for tag in subject.tags %}<a class="tag-link" href="/t/{{ tag.slug }}/">#{{ tag.slug }}</a>{% endfor %}
        </span>
        {% endif %}
      </p>
    </div>
  </header>

  {% if subject.essayHtml %}
  <div class="essay">{{ subject.essayHtml | safe }}</div>
  {% endif %}

  {% if subject.fragments | length %}
  <section class="timeline">
    {% if subject.essayHtml %}<h2 class="timeline-head">Along the way</h2>{% endif %}
    {% for fragment in subject.fragments %}
    <div class="fragment">
      <a class="fragment-date" href="{{ fragment.sourceUrl }}">{{ fragment.date | readableDate }}</a>
      {{ fragment.html | safe }}
    </div>
    {% endfor %}
  </section>
  {% elif not subject.essayHtml %}
  <p class="empty">Nothing written about this yet.</p>
  {% endif %}
</article>
