---
permalink: /essays/feed.xml
eleventyExcludeFromCollections: true
---
{#- The essays-only feed (2026-11-03), the second of the site's two. Same
    entries and the same entry ids as /feed.xml, so a reader subscribed to
    both sees each essay once. Its own feed id, and a title a reader listing
    both feeds shows as "chaosh.at · essays"; the subtitle names the full
    feed, for whoever subscribed to this one thinking it was everything.
    base.njk always advertises /feed.xml first, so a subscribe button that
    takes the first alternate gets the full one. -#}
{%- set entries = collections.essayFeed -%}
{%- set newest = entries[0].shipped if entries | length -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title }} · essays</title>
  <subtitle>Essays only. Everything, the daily posts too: {{ site.url }}/feed.xml</subtitle>
  <link href="{{ site.url }}/essays/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.url }}/essays/" rel="alternate" type="text/html"/>
  <id>{{ site.url }}/essays/</id>
  <author><name>{{ site.author }}</name></author>
  {#- Feed-level updated is the newest ENTRY date, never the build time. -#}
  <updated>{{ newest | atomDate if newest else "1970-01-01T00:00:00.000Z" }}</updated>
  {%- for entry in entries %}
  <entry>
    <title>{{ entry.title }}</title>
    <link href="{{ site.url }}{{ entry.url }}" rel="alternate" type="text/html"/>
    {#- The same permanent id the full feed gives this essay. -#}
    <id>tag:chaosh.at,{{ entry.date | dateSlug }}:{{ entry.url }}</id>
    <published>{{ entry.shipped | atomDate }}</published>
    <updated>{{ entry.shipped | atomDate }}</updated>
    <content type="html">{{ entry.html | absoluteUrls(site.url) | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
